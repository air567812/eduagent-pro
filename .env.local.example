# ====================================================================
# EduAgent Pro Environment Configuration
# ====================================================================

# 1. OpenAI Configuration (Required for live GPT-4o Agent analysis)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 2. Firebase & Cloud Firestore Configuration
# (Obtain these from your Firebase Project Console -> Project Settings -> General -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id

# 3. Stripe Automated Billing (Optional for production live card payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Database (SQLite for local relational caching / PostgreSQL for production)
DATABASE_URL="file:./dev.db"
